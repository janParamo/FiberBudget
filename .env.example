# --- PostgreSQL / PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fiber_budget
DB_USER=replace_me
DB_PASSWORD=replace_me

# --- Google Directions API ---
GOOGLE_API_KEY=replace_me

# --- Service security: n8n must send this in the X-API-Key header ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=replace_me

# --- Paths ---
# Required: use the company's real workbook, not the test fixture.
TEMPLATE_PATH=templates/PlantilaEjemploPresupuesto.xlsx
OUTPUT_DIR=output
RULES_PATH=business_rules.yaml
LOG_FILE=logs/service.log
# Visio diagrams database as SQLite file: fallback when the PostgreSQL copy below is unreachable.
RED_FIBRA_DB=red_fibra/red_fibra.db
# Network KMZ for the viewer's "Lugares" panel (display only; budgets keep using PostGIS):
# the .kmz file, or the folder that holds it (its newest .kmz is used).
KMZ_PATH=red_kmz

# --- Visio network in PostgreSQL (schema red_fibra, published by red_fibra/publicar_postgres.py) ---
# Separate from DB_* above (that one holds the KMZ data: red_puntos, red_lineas).
# Leave VISIO_DB_NAME empty to disable it.
VISIO_DB_HOST=localhost
VISIO_DB_PORT=5432
VISIO_DB_NAME=Presupuesto_visio
VISIO_DB_USER=postgres
VISIO_DB_PASSWORD=replace_me
# Search radius around the client (m) and number of candidates returned.
RADIO_BUSQUEDA_M=2000
MAX_CANDIDATOS=5

# --- HTTP service ---
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=60
OUTPUT_RETENTION_DAYS=30

# --- LibreOffice: caches formula results (real totals) and converts budgets to PDF ---
# Path to soffice.exe, e.g. LibreOffice Portable:
#   C:\Users\jgutierrez\LibreOfficePortable\App\libreoffice\program\soffice.exe
# Empty, or a path that does not exist: autodetected (PATH, C:\Program Files\LibreOffice).
LIBREOFFICE_PATH=

# --- Route viewer on other computers (VisorRutas.exe, endpoints /visor/*) ---
# One key per person, "name:key" separated by commas; sent in the X-Visor-Key header.
# Different from SERVICE_API_KEY (n8n). Empty = /visor/* disabled (404). Read on every request:
# adding or removing a person needs no restart.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(24))"
VISOR_API_KEYS=
# Requests per person and hour on the endpoints that can call Google (ruta, estimacion, presupuesto).
VISOR_RATE_LIMIT_PER_HOUR=60

# --- ngrok (public tunnel) ---
# Leave NGROK_DOMAIN empty to disable the tunnel.
NGROK_AUTHTOKEN=replace_me
NGROK_DOMAIN=broken-snowy-credibly.ngrok-free.dev
# Libro de rutas de fusión donde el visor agrega una franja (por defecto la copia del proyecto; luego el de la nube)
#RUTA_FUSION_XLSX=EjemploRutaFusiones/RUTA DE FUSION - Copia.xlsx
