# Plantilla del .env para el CONTENEDOR. Copiar a la raiz del proyecto como `.env` y completar:   cp docker/env.ejemplo .env
# Nunca se sube a Git. Evite el signo $ en los valores (docker compose lo interpreta). Sin comillas.

# --- Base de datos del KMZ (Presupuesto_fibra). Con el perfil "db" de docker-compose.yml: DB_HOST=db ---
DB_HOST=db
DB_PORT=5432
DB_NAME=Presupuesto_fibra
DB_USER=postgres
DB_PASSWORD=CAMBIAR

# --- Base de los diagramas Visio y del modulo de redes (Presupuesto_visio) ---
VISIO_DB_HOST=db
VISIO_DB_PORT=5432
VISIO_DB_NAME=Presupuesto_visio
VISIO_DB_USER=postgres
VISIO_DB_PASSWORD=CAMBIAR
RADIO_BUSQUEDA_M=2000
MAX_CANDIDATOS=5

# --- Google Directions ---
GOOGLE_API_KEY=CAMBIAR

# --- Claves ---
# n8n manda SERVICE_API_KEY en el header X-API-Key.  Generar:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=CAMBIAR
# Quien usa el visor (revisores): "nombre:clave" separados por comas.
VISOR_API_KEYS=
# Los tecnicos de campo (app del telefono): una clave propia cada uno. Solo abren la app de campo.
CAMPO_API_KEYS=
VISOR_RATE_LIMIT_PER_HOUR=60

# --- Rutas DENTRO del contenedor (no cambiar; las carpetas de la VM se eligen en docker-compose.yml) ---
TEMPLATE_PATH=templates/PlantilaEjemploPresupuesto.xlsx
OUTPUT_DIR=output
RULES_PATH=business_rules.yaml
LOG_FILE=logs/service.log
KMZ_PATH=datos/kmz
OUTPUT_RETENTION_DAYS=30
REQUEST_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
# LibreOffice esta en el PATH de la imagen: se deja vacio.
LIBREOFFICE_PATH=

# --- Respaldos del modulo de redes (carpeta /respaldos del contenedor) ---
REDES_RESPALDOS_DIR=/respaldos
REDES_RESPALDOS_CONSERVAR=20

# --- Como se entra desde afuera: UNA de estas dos ---
# (a) ngrok dentro del contenedor (lo abre el propio servicio). OJO: la misma direccion no puede estar encendida a la vez en la PC y aqui.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# (b) Un subdominio de la empresa con HTTPS (perfil "https"): DNS del subdominio -> esta VM, puertos 80 y 443 abiertos.
DOMINIO=
# Direccion publica de la app de campo (la que se le da a los tecnicos): https://<NGROK_DOMAIN> o https://<DOMINIO>
CAMPO_URL_PUBLICA=

# --- Solo para docker-compose.yml (no las lee la aplicacion) ---
VERSION=local
PUERTO=8000
POSTGIS_IMAGE=postgis/postgis:18-3.6
# Carpetas de la VM (por defecto ./volumenes/...). El usuario del contenedor es 1000:1000: chown -R 1000:1000 sobre ellas.
# DIR_DATOS=./volumenes/datos
# DIR_OUTPUT=./volumenes/output
# DIR_LOGS=./volumenes/logs
# DIR_RESPALDOS=./volumenes/respaldos
